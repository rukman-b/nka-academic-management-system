############################################
# Application
############################################
APP_NAME="NKA Academic Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

############################################
# Logging
############################################
LOG_CHANNEL=stack
LOG_LEVEL=debug

############################################
# Database (Docker: MariaDB)
############################################
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nka_hub
DB_USERNAME=nka_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
DB_TEST_DATABASE=nka_hub_testing

############################################
# Cache / Session / Queue
############################################
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

############################################
# Redis (Docker)
############################################
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Separate Redis DB indexes
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Cache prefix (applies via config/cache.php)
CACHE_PREFIX=nka_hub_cache_

SESSION_STORE=sessions
SESSION_PREFIX=nka_hub_session_
SESSION_CONNECTION=default


REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90


############################################
# Mail (Local / Safe Defaults)
############################################
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@nka.local"
MAIL_FROM_NAME="${APP_NAME}"

############################################
# Filesystem
############################################
FILESYSTEM_DISK=local

############################################
# Session
############################################
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

############################################
# Broadcasting
############################################
BROADCAST_DRIVER=log

############################################
# Vite / Frontend
############################################
VITE_APP_NAME="${APP_NAME}"

############################################
# Security / Auth
############################################
PASSWORD_TIMEOUT=10800

############################################
# NKA Project Flags
############################################
NKA_AUTH_DEBUG=false


############################################
# Docker Host Port Forwarding
############################################
# These values control which ports are exposed on your local machine.
# The containers still use their internal Docker ports, but your host
# machine can access them through the forwarded ports below.
#
# Example:
# DB_FORWARD_PORT=3307 means MariaDB is available from Ubuntu at localhost:3307,
# while Laravel still connects to the database internally using DB_HOST=db and DB_PORT=3306.

APP_FORWARD_PORT=8000
PHPMYADMIN_FORWARD_PORT=8080
VITE_FORWARD_PORT=5173
DB_FORWARD_PORT=3307
REDIS_FORWARD_PORT=6380
